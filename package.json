{
  "name": "three-game-forge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": ["packages/*"],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:packages && tsc --noEmit && vite build",
    "build:packages": "tsc -p tsconfig.build.json",
    "validate:packages": "npm run build:packages && node scripts/validate-package-outputs.mjs",
    "smoke:packages": "npm run validate:packages && node scripts/consumer-smoke.mjs",
    "audit:consumers": "node scripts/audit-consumers.mjs",
    "audit:consumers:strict": "node scripts/audit-consumers.mjs --strict",
    "typecheck": "tsc --noEmit",
    "demo:repair-scene": "tsx scripts/repair-scene-local.mts",
    "eval:repair-scene": "tsx scripts/eval-scene-repair.mts",
    "mcp": "tsx packages/mcp/src/index.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp-session.mts",
    "test": "tsx --test tests/runtime.test.ts tests/scene.test.ts tests/scene-consumers.test.ts tests/scene-repair.test.ts tests/scene-model.test.ts tests/scene-llm-repair.test.ts tests/sibling-crate-hash.test.ts tests/assets-gltf.test.ts tests/openai-complete.test.ts tests/scene-repair-eval-manifest.test.ts tests/mcp-session.test.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
